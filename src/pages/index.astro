---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CuentaAtras from '../components/CuentaAtras.astro';
import { SITE, href } from '../consts';

import fotoFresnedilla from '../assets/fresnedilla/hero-centro.jpg';
import fotoPlanetario from '../assets/planetario/panoramica.jpg';
import fotoLuna from '../assets/astrofotografia/varios-autores-la-luna.jpg';
import fotoSimulacion from '../assets/simulaciones/pluto-new-horizons.png';
import fotoBlog from '../assets/blog/2015/01/2014-Q2-Rolando-Ligustri.jpg';
import fotoEclipse from '../assets/astrofotografia/antonio-herrera-eclipse-total-de-sol-2026.jpg';

/**
 * Segundo eclipse del trío ibérico: total por la costa andaluza, parcial muy
 * profundo en Úbeda. Circunstancias locales calculadas con las efemérides
 * DE421 y validadas con los datos oficiales del IGN para el eclipse de 2026
 * (coinciden en ±2 s y ±0,03 puntos): inicio 09:43, máximo 10:50 con el
 * 96,3 % del Sol oculto a 40° de altura, fin 12:04.
 */
const eclipse2027 = {
  titulo: 'Eclipse total de Sol del 2 de agosto de 2027',
  inicioISO: '2027-08-02T09:43:00+02:00',
  oscurecimiento: '96,3 %',
};

const actividades = (await getCollection('actividades', ({ data }) => !data.historica))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

const tarjetas = [
  {
    titulo: 'Astrofotografía',
    texto:
      'Galaxias, cometas, la Luna y el Sol fotografiados desde la provincia de Jaén por los socios. Más de 150 imágenes con su autor y su historia.',
    ruta: '/astrofotografia/',
    cta: 'Abrir la galería',
    imagen: fotoLuna,
    alt: 'La Luna fotografiada por los socios de la asociación',
  },
  {
    titulo: 'Centro de Observación (La Fresnedilla)',
    texto:
      'Nuestro observatorio y centro de divulgación en plena Sierra de las Villas, construido piedra a piedra por los socios. Ayúdanos a mantenerlo vivo.',
    ruta: '/la-fresnedilla/',
    cta: 'Conócelo y colabora',
    imagen: fotoFresnedilla,
    alt: 'Edificio blanco del Centro de La Fresnedilla con su cúpula de observación, rodeado de árboles en la Sierra de las Villas',
  },
  {
    titulo: 'Planetario de Úbeda',
    texto:
      'Un planetario construido artesanalmente por la asociación en el Hospital de Santiago: más de 3.000 estrellas bajo una cúpula de seis metros.',
    ruta: '/planetario/',
    cta: 'Visítalo',
    imagen: fotoPlanetario,
    alt: 'Interior del Planetario de Úbeda: butacas circulares alrededor del proyector bajo la cúpula',
  },
  {
    titulo: 'Simulaciones',
    texto:
      'Aprende jugando: simulaciones interactivas para explorar el cosmos desde el navegador, empezando por el viaje de la New Horizons a Plutón.',
    ruta: '/simulaciones/',
    cta: 'Explorar',
    imagen: fotoSimulacion,
    alt: 'Simulación interactiva de la trayectoria de la sonda New Horizons por el sistema solar',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: SITE.nombre,
      email: SITE.email,
      foundingDate: String(SITE.fundacion),
      url: new URL(import.meta.env.BASE_URL, Astro.site).toString(),
      location: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: 'Úbeda', addressRegion: 'Jaén', addressCountry: 'ES' } },
    },
    {
      '@type': 'Event',
      name: `${eclipse2027.titulo} (visible desde Úbeda)`,
      startDate: eclipse2027.inicioISO,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: { '@type': 'Place', name: 'Úbeda', address: { '@type': 'PostalAddress', addressLocality: 'Úbeda', addressRegion: 'Jaén', addressCountry: 'ES' } },
      organizer: { '@type': 'Organization', name: SITE.nombre, email: SITE.email },
    },
  ],
};
---

<Base>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <!-- HERO: eclipse del 12 de agosto de 2026 -->
  <section class="relative overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-14 sm:px-6 sm:pt-24 sm:pb-20">
      <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_clamp(380px,40vw,560px)] lg:gap-16">
        <div class="min-w-0">
      <div class="flex items-center gap-3">
        <img
          src={href('/logo-aaq.png')}
          alt=""
          width="44"
          height="44"
          class="h-11 w-11 rounded-full ring-2 ring-star-400/40"
        />
        <p class="font-display text-lg leading-tight font-bold text-fog-50 sm:text-xl">
          Asociación Astronómica <span
            class="bg-linear-to-r from-star-200 to-star-500 bg-clip-text text-transparent"
            >«Quarks»</span
          > de Úbeda
        </p>
      </div>
      <p class="eyebrow mt-7">2 de agosto de 2027 · Úbeda</p>
      <h1 class="heading mt-4 max-w-3xl text-4xl leading-[1.08] sm:text-6xl">
        El primero del trío ya pasó:<br />
        <span class="text-star-300">el segundo está en camino</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-fog-300">
        El 12 de agosto de 2026 vivimos desde Úbeda un atardecer histórico con el 97,2&nbsp;% del
        Sol oculto. Ahora toca esperar al segundo eclipse del trío
        ibérico: el <strong class="text-fog-100">2 de agosto de 2027</strong>, un eclipse total de
        Sol recorrerá toda la costa andaluza, y desde Úbeda
        veremos el <strong class="text-fog-100">{eclipse2027.oscurecimiento} del Sol oculto</strong>,
        esta vez a media mañana. Tenemos un año para prepararlo.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href={href('/eclipses/2027/')}
          class="inline-flex items-center gap-2 rounded-xl bg-star-400 px-6 py-3.5 font-display text-lg font-semibold text-night-950 shadow-lg shadow-star-400/20 transition-colors hover:bg-star-300"
        >
          Todo sobre el eclipse de 2027
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h12m0 0-4.5-4.5M16 10l-4.5 4.5" />
          </svg>
        </a>
      </div>
        </div>

        <figure class="mx-auto w-full max-w-md lg:mx-0 lg:max-w-none lg:sticky lg:top-24">
          <div class="card overflow-hidden p-2 ring-1 ring-star-400/15">
            <Image
              src={fotoEclipse}
              alt="Eclipse total de Sol del 12 de agosto de 2026 fotografiado por Antonio Herrera: la corona y las protuberancias rojas rodean el disco negro de la Luna"
              width={760}
              height={760}
              loading="eager"
              class="w-full rounded-xl"
            />
          </div>
          <figcaption class="mt-3 text-center text-xs leading-snug text-fog-400">
            El eclipse del <strong class="text-fog-200">12 de agosto de 2026</strong> desde el
            Santuario de la Virgen del Acebo. Fotografía de Antonio Herrera (Seestar&nbsp;S50).
          </figcaption>
        </figure>
      </div>

      <div class="mt-10 grid items-center gap-6 lg:grid-cols-2">
        <a
          href={href('/eclipses/2027/#seguridad')}
          class="group flex items-center gap-3 rounded-xl border-2 border-warn-400/70 bg-warn-400/10 px-4 py-3.5 transition-colors hover:bg-warn-400/20"
        >
          <svg
            class="h-8 w-8 shrink-0 text-warn-300"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"
            ></path>
          </svg>
          <p class="font-display leading-snug font-semibold text-fog-100 sm:text-lg">
            Y recuerda: <strong class="text-warn-300">nunca mires al eclipse sin gafas de protección
            homologadas</strong>. El daño ocular es grave e irreversible.
            <span
              class="mt-1 block text-sm font-medium text-warn-300 underline decoration-warn-400/40 underline-offset-4 group-hover:decoration-warn-300"
            >
              Aprende a observarlo con seguridad →
            </span>
          </p>
        </a>

        <div class="lg:justify-self-end">
          <p class="mb-3 text-sm font-semibold tracking-widest text-fog-400 uppercase">
            Cuenta atrás para el <span class="text-star-300">segundo eclipse</span> · <span class="text-star-300">2 de agosto de 2027</span>
          </p>
          <CuentaAtras objetivoISO={eclipse2027.inicioISO} />
        </div>
      </div>
    </div>
  </section>

  <!-- Tarjetas de secciones -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6" aria-label="Secciones destacadas">
    <div class="grid gap-6 sm:grid-cols-2">
      <!-- Blog: tarjeta ancha que abre la rejilla -->
      <a href={href('/blog/')} class="card card-hover group block overflow-hidden sm:col-span-2 md:flex">
        <div class="aspect-[16/9] overflow-hidden bg-night-900 md:aspect-auto md:w-2/5">
          <Image
            src={fotoBlog}
            alt="El cometa C/2014 Q2 (Lovejoy), protagonista de la primera entrada del blog"
            width={640}
            height={360}
            fit="cover"
            class="h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105"
          />
        </div>
        <div class="p-6 md:flex-1 md:self-center">
          <h2 class="font-display text-2xl font-semibold text-fog-50 transition-colors group-hover:text-star-300">
            Blog
          </h2>
          <p class="mt-2 leading-relaxed text-fog-300">
            Más de una década de entradas recuperadas de nuestra web anterior (2014–2026):
            crónicas de actividades, las Jornadas de la Ciencia, cometas, eclipses y el cielo
            de cada mes, con filtros por año y temática.
          </p>
          <p class="mt-4 inline-flex items-center gap-1.5 font-display font-medium text-star-400">
            Leer el blog
            <svg class="h-4 w-4 transition-transform motion-safe:group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h12m0 0-4.5-4.5M16 10l-4.5 4.5" />
            </svg>
          </p>
        </div>
      </a>
      {
        tarjetas.map((tarjeta) => (
          <a href={href(tarjeta.ruta)} class="card card-hover group block overflow-hidden">
            <div class="aspect-[16/9] overflow-hidden bg-night-900">
              <Image
                src={tarjeta.imagen}
                alt={tarjeta.alt}
                width={640}
                height={360}
                fit="cover"
                class="h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105"
              />
            </div>
            <div class="p-6">
              <h2 class="font-display text-2xl font-semibold text-fog-50 group-hover:text-star-300 transition-colors">
                {tarjeta.titulo}
              </h2>
              <p class="mt-2 leading-relaxed text-fog-300">{tarjeta.texto}</p>
              <p class="mt-4 inline-flex items-center gap-1.5 font-display font-medium text-star-400">
                {tarjeta.cta}
                <svg class="h-4 w-4 transition-transform motion-safe:group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h12m0 0-4.5-4.5M16 10l-4.5 4.5" />
                </svg>
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Últimas actividades -->
  {
    actividades.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6" aria-labelledby="titulo-actividades">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="titulo-actividades" class="heading text-3xl">
            Actividades
          </h2>
          <a href={href('/actividades/')} class="font-display text-sm font-medium text-star-400 hover:text-star-300">
            Ver todas →
          </a>
        </div>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {actividades.map((actividad) => (
            <a href={href(`/actividades/${actividad.id}/`)} class="card card-hover block p-5">
              <time class="text-xs tracking-widest text-fog-400 uppercase" datetime={actividad.data.fecha.toISOString()}>
                {actividad.data.fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' })}
              </time>
              <h3 class="mt-2 font-display text-lg font-semibold text-fog-50">{actividad.data.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-fog-300">{actividad.data.resumen}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Quiénes somos, en breve -->
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
    <div class="card flex flex-col items-start gap-6 p-8 sm:p-10 md:flex-row md:items-center">
      <div class="flex-1">
        <h2 class="heading text-2xl sm:text-3xl">Desde 1989, mirando el cielo de Jaén</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-fog-300">
          Somos más de cien socios que construimos telescopios, un planetario y un observatorio en
          la sierra; organizamos observaciones públicas y llevamos la astronomía a colegios y
          asociaciones de toda la provincia. Únete: no hace falta saber nada de astronomía, solo
          tener curiosidad.
        </p>
      </div>
      <a
        href={href('/asociacion/')}
        class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-star-400/60 px-6 py-3 font-display font-semibold text-star-300 transition-colors hover:bg-star-400/10"
      >
        Conoce la asociación
      </a>
    </div>
  </section>
</Base>


