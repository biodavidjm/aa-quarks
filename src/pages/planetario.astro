---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';

import fotoPanoramica from '../assets/planetario/panoramica.jpg';
import fotoHospital from '../assets/planetario/hospital-santiago.jpg';
import fotoPublico from '../assets/planetario/publico.jpg';
import fotoCuento from '../assets/planetario/cuento-valeria.jpg';

const pagina = await getEntry('paginas', 'planetario');
if (!pagina) throw new Error('Falta src/content/paginas/planetario.md');
const { Content } = await render(pagina);
const d = pagina.data as any;
---

<Base titulo={d.titulo} descripcion={d.descripcion}>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="eyebrow">Hospital de Santiago · Úbeda</p>
    <h1 class="heading mt-3 text-4xl sm:text-5xl">Planetario de Úbeda</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-fog-300">
      Más de 3.000 estrellas bajo una cúpula de seis metros, en pleno corazón renacentista de
      Úbeda. Y con una historia que contar: lo construyeron, pieza a pieza, los socios de la
      asociación.
    </p>

    <figure class="card mt-10 overflow-hidden">
      <Image
        src={fotoPanoramica}
        alt="Panorámica del interior del Planetario de Úbeda: butacas en círculo alrededor del proyector de estrellas, bajo la cúpula de proyección"
        widths={[640, 950]}
        sizes="(min-width: 1152px) 1104px, 100vw"
        class="w-full object-cover"
        loading="eager"
      />
      <figcaption class="p-3 text-xs text-fog-400">
        La sala de proyección: cuarenta butacas alrededor del proyector artesanal.
      </figcaption>
    </figure>

    <div class="mt-12 grid gap-10 lg:grid-cols-[2fr_1fr]">
      <div class="prose prose-invert prose-quarks max-w-none">
        <Content />
      </div>
      <div class="space-y-4">
        <figure class="card overflow-hidden">
          <Image src={fotoHospital} alt="León de piedra ante la fachada del Hospital de Santiago de Úbeda, sede del planetario" width={480} height={640} fit="cover" class="aspect-[3/4] w-full object-cover" />
          <figcaption class="p-3 text-xs text-fog-400">El Hospital de Santiago, sede del planetario.</figcaption>
        </figure>
        <figure class="card overflow-hidden">
          <Image src={fotoPublico} alt="Público sentado en el interior del planetario antes de una sesión" width={480} height={320} fit="cover" class="aspect-[3/2] w-full object-cover" />
          <figcaption class="p-3 text-xs text-fog-400">Una sesión abierta al público.</figcaption>
        </figure>
        <figure class="card overflow-hidden">
          <Image src={fotoCuento} alt="Portada del cuento infantil del programa «Valeria y la Luna»" width={480} height={340} fit="cover" class="aspect-[3/2] w-full object-cover" />
          <figcaption class="p-3 text-xs text-fog-400">Los programas infantiles tienen cuento propio.</figcaption>
        </figure>
      </div>
    </div>

    <!-- Programas -->
    <section aria-labelledby="titulo-programas" class="mt-16">
      <h2 id="titulo-programas" class="heading text-3xl">Programas en cartelera</h2>
      <p class="mt-2 max-w-2xl text-fog-300">
        Sesiones para todas las edades, de la escuela infantil a los adultos.
      </p>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          d.programas.map((programa: { nombre: string; publico: string; resumen: string }) => (
            <div class="card card-hover p-6">
              <p class="text-xs font-medium tracking-widest text-ice-300 uppercase">{programa.publico}</p>
              <h3 class="mt-2 font-display text-xl font-semibold text-fog-50">{programa.nombre}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-fog-300">{programa.resumen}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Visitas -->
    <section aria-labelledby="titulo-visitas-planetario" class="mt-16">
      <h2 id="titulo-visitas-planetario" class="heading text-3xl">Reserva tu sesión</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        {
          d.visitas.map((visita: { tipo: string; cuando: string }) => (
            <div class="card p-6">
              <h3 class="font-display text-xl font-semibold text-fog-50">{visita.tipo}</h3>
              <p class="mt-1.5 text-star-400">{visita.cuando}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-4 max-w-3xl text-xs leading-relaxed text-fog-400">{d.avisoVisitas}</p>
      <p class="mt-5 text-fog-200">
        Información y reservas:
        <a
          class="font-medium text-star-300 underline decoration-star-400/40 underline-offset-4 hover:text-star-200"
          href={`mailto:${SITE.emailPlanetario}`}>{SITE.emailPlanetario}</a
        >
      </p>
      <!-- TODO(asociación): confirmar el teléfono de reservas del planetario
           (en la web antigua figuraba vacío). -->
    </section>
  </div>
</Base>
