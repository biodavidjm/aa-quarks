---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { href } from '../../consts';

const entradas = (await getCollection('blog')).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
);

const anios = [...new Set(entradas.map((e) => e.data.fecha.getFullYear()))].sort((a, b) => b - a);

/* Categorías ordenadas por número de entradas. */
const categorias = [...entradas.reduce((mapa, e) => {
  for (const c of e.data.categorias) mapa.set(c, (mapa.get(c) ?? 0) + 1);
  return mapa;
}, new Map<string, number>())].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'es'));

const primerAnio = anios[anios.length - 1];
const ultimoAnio = anios[0];
---

<Base
  titulo="Blog"
  descripcion={`El blog de la Asociación Astronómica Quarks (${primerAnio}–${ultimoAnio}): ${entradas.length} entradas sobre actividades, jornadas de la ciencia, cometas, eclipses y el cielo de Úbeda, recuperadas de nuestra web anterior.`}
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="eyebrow">Archivo {primerAnio}–{ultimoAnio}</p>
    <h1 class="heading mt-3 text-4xl sm:text-5xl">Blog</h1>
    <p class="mt-4 max-w-2xl leading-relaxed text-fog-300">
      Las {entradas.length} entradas del blog de la asociación, recuperadas de nuestra web
      anterior: crónicas de actividades y de las Jornadas de la Ciencia, cometas, eclipses,
      el cielo de cada mes y la vida del Planetario y de La Fresnedilla, tal y como las
      contamos entonces.
    </p>

    <!-- Filtro por año -->
    <div class="mt-8">
      <p class="text-xs tracking-widest text-fog-400 uppercase">Año</p>
      <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Filtrar por año">
        <button
          type="button"
          data-anio="todos"
          aria-pressed="true"
          class="filtro-anio rounded-full border border-night-600 px-4 py-1.5 text-sm font-medium text-fog-200 transition-colors hover:border-star-400/60 aria-pressed:border-star-400 aria-pressed:bg-star-400/15 aria-pressed:text-star-300"
        >
          Todos
        </button>
        {
          anios.map((anio) => (
            <button
              type="button"
              data-anio={String(anio)}
              aria-pressed="false"
              class="filtro-anio rounded-full border border-night-600 px-4 py-1.5 text-sm font-medium text-fog-200 transition-colors hover:border-star-400/60 aria-pressed:border-star-400 aria-pressed:bg-star-400/15 aria-pressed:text-star-300"
            >
              {anio}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Filtro por temática -->
    <div class="mt-5">
      <p class="text-xs tracking-widest text-fog-400 uppercase">Temática</p>
      <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Filtrar por temática">
        <button
          type="button"
          data-categoria="todas"
          aria-pressed="true"
          class="filtro-cat rounded-full border border-night-600 px-4 py-1.5 text-sm font-medium text-fog-200 transition-colors hover:border-star-400/60 aria-pressed:border-star-400 aria-pressed:bg-star-400/15 aria-pressed:text-star-300"
        >
          Todas ({entradas.length})
        </button>
        {
          categorias.map(([nombre, n]) => (
            <button
              type="button"
              data-categoria={nombre}
              aria-pressed="false"
              class="filtro-cat rounded-full border border-night-600 px-4 py-1.5 text-sm font-medium text-fog-200 transition-colors hover:border-star-400/60 aria-pressed:border-star-400 aria-pressed:bg-star-400/15 aria-pressed:text-star-300"
            >
              {nombre} ({n})
            </button>
          ))
        }
      </div>
    </div>

    <!-- Entradas -->
    <div id="entradas" class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        entradas.map((entrada, i) => (
          <a
            href={href(`/blog/${entrada.id}/`)}
            data-anio={String(entrada.data.fecha.getFullYear())}
            data-categorias={entrada.data.categorias.join('|')}
            class="entrada card card-hover group flex flex-col overflow-hidden"
          >
            <div class="aspect-[16/9] overflow-hidden bg-night-900">
              {entrada.data.imagen ? (
                <Image
                  src={entrada.data.imagen}
                  alt=""
                  width={640}
                  height={360}
                  fit="cover"
                  loading={i < 6 ? 'eager' : 'lazy'}
                  class="h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center" aria-hidden="true">
                  <svg class="h-12 w-12 text-night-600" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l2.4 6.9L21 11l-6.6 2.1L12 20l-2.4-6.9L3 11l6.6-2.1z" />
                  </svg>
                </div>
              )}
            </div>
            <div class="flex flex-1 flex-col p-5">
              <time
                class="text-xs tracking-widest text-fog-400 uppercase"
                datetime={entrada.data.fecha.toISOString()}
              >
                {entrada.data.fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' })}
              </time>
              <h2 class="mt-2 font-display text-lg leading-snug font-semibold text-fog-50 transition-colors group-hover:text-star-300">
                {entrada.data.titulo}
              </h2>
              <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-fog-300">
                {entrada.data.resumen}
              </p>
              {entrada.data.categorias.length > 0 && (
                <p class="mt-auto flex flex-wrap gap-1.5 pt-4">
                  {entrada.data.categorias.map((c) => (
                    <span class="rounded-full bg-star-400/10 px-2.5 py-0.5 text-xs font-medium text-star-300">
                      {c}
                    </span>
                  ))}
                </p>
              )}
            </div>
          </a>
        ))
      }
    </div>

    <p id="sin-resultados" hidden class="mt-10 text-center text-fog-400">
      No hay entradas de esa temática en ese año. Prueba con otro filtro.
    </p>
  </div>
</Base>

<script>
  const botonesAnio = document.querySelectorAll<HTMLButtonElement>('.filtro-anio');
  const botonesCat = document.querySelectorAll<HTMLButtonElement>('.filtro-cat');
  const entradas = document.querySelectorAll<HTMLElement>('#entradas a.entrada');
  const vacio = document.getElementById('sin-resultados');

  let anio = 'todos';
  let categoria = 'todas';

  function aplicar() {
    let visibles = 0;
    entradas.forEach((entrada) => {
      const coincideAnio = anio === 'todos' || entrada.dataset.anio === anio;
      const coincideCat =
        categoria === 'todas' || (entrada.dataset.categorias ?? '').split('|').includes(categoria);
      const coincide = coincideAnio && coincideCat;
      entrada.toggleAttribute('hidden', !coincide);
      if (coincide) visibles++;
    });
    vacio?.toggleAttribute('hidden', visibles > 0);
  }

  botonesAnio.forEach((boton) => {
    boton.addEventListener('click', () => {
      anio = boton.dataset.anio!;
      botonesAnio.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));
      aplicar();
    });
  });
  botonesCat.forEach((boton) => {
    boton.addEventListener('click', () => {
      categoria = boton.dataset.categoria!;
      botonesCat.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));
      aplicar();
    });
  });
</script>
