---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { href } from '../../consts';

const simulaciones = (await getCollection('simulaciones')).sort(
  (a, b) => (b.data.fecha?.getTime() ?? 0) - (a.data.fecha?.getTime() ?? 0)
);
---

<Base
  titulo="Simulaciones"
  descripcion="Simulaciones astronómicas interactivas para explorar el cosmos desde el navegador: trayectorias de sondas, órbitas y más. Una colección en crecimiento de la Asociación Astronómica Quarks."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="eyebrow">Aprende jugando</p>
    <h1 class="heading mt-3 text-4xl sm:text-5xl">Simulaciones</h1>
    <p class="mt-4 max-w-2xl leading-relaxed text-fog-300">
      Pequeños laboratorios interactivos para tocar el cosmos con las manos: mueve el tiempo,
      cambia la escala y entiende cómo se mueven las cosas ahí arriba. La colección irá creciendo;
      cada simulación se abre en su propia página.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        simulaciones.map((simulacion) => {
          const externa = simulacion.data.ruta.startsWith('http');
          const destino = externa ? simulacion.data.ruta : href(simulacion.data.ruta);
          return (
            <a {...(externa ? { rel: 'noopener' } : {})} href={destino} class="card card-hover group block overflow-hidden">
              <div class="aspect-[3/2] overflow-hidden bg-night-900">
                <Image
                  src={simulacion.data.miniatura}
                  alt={`Vista previa de la simulación «${simulacion.data.titulo}»`}
                  width={640}
                  height={426}
                  fit="cover"
                  class="h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105"
                />
              </div>
              <div class="p-6">
                <h2 class="font-display text-2xl font-semibold text-fog-50 transition-colors group-hover:text-star-300">
                  {simulacion.data.titulo}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-fog-300">{simulacion.data.descripcion}</p>
                {simulacion.data.autor && <p class="mt-3 text-xs text-fog-500">Por {simulacion.data.autor}</p>}
                <p class="mt-4 inline-flex items-center gap-1.5 font-display font-medium text-star-400">
                  Abrir simulación
                  <svg class="h-4 w-4 transition-transform motion-safe:group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h12m0 0-4.5-4.5M16 10l-4.5 4.5" />
                  </svg>
                </p>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</Base>
