---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { href } from '../../consts';

export async function getStaticPaths() {
  const actividades = await getCollection('actividades');
  return actividades.map((actividad) => ({ params: { slug: actividad.id }, props: { actividad } }));
}

const { actividad } = Astro.props;
const { Content } = await render(actividad);
const { data } = actividad;

/* Para el visor generamos el cartel optimizado a tamaño completo. */
const cartelGrande = data.cartel ? await getImage({ src: data.cartel, format: 'webp' }) : undefined;
---

<Base titulo={data.titulo} descripcion={data.resumen}>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <a href={href('/actividades/')} class="text-sm font-medium text-star-400 hover:text-star-300">
      ← Todas las actividades
    </a>
    <time
      class="mt-6 block text-xs tracking-widest text-fog-400 uppercase"
      datetime={data.fecha.toISOString()}
    >
      {data.fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' })}
      {data.historica && ' · Archivo histórico'}
    </time>
    <h1 class="heading mt-3 text-3xl sm:text-4xl">{data.titulo}</h1>
    {data.autor && <p class="mt-3 text-sm text-fog-400">Por {data.autor}</p>}

    {
      data.imagen && (
        <figure class="card mt-8 overflow-hidden">
          <Image
            src={data.imagen}
            alt={data.creditoImagen ?? data.titulo}
            widths={[640, 960]}
            sizes="(min-width: 768px) 736px, 100vw"
            class="w-full object-cover"
          />
          {data.creditoImagen && <figcaption class="p-3 text-xs text-fog-400">{data.creditoImagen}</figcaption>}
        </figure>
      )
    }

    {
      data.cartel && cartelGrande && (
        <figure id="cartel" class="mx-auto mt-8 w-48 sm:float-right sm:mt-10 sm:ml-8 sm:w-52">
          <a
            href={cartelGrande.src}
            data-pswp-width={cartelGrande.attributes.width}
            data-pswp-height={cartelGrande.attributes.height}
            target="_blank"
            rel="noopener"
            class="card card-hover block overflow-hidden p-1.5"
            aria-label="Ver el cartel en grande"
          >
            <Image
              src={data.cartel}
              alt={`Cartel: ${data.titulo}`}
              widths={[208, 416]}
              sizes="(min-width: 640px) 208px, 192px"
              class="w-full rounded-lg"
            />
          </a>
          <figcaption class="mt-2 text-center text-xs text-fog-400">Cartel · pulsa para ampliar</figcaption>
        </figure>
      )
    }

    <div class="prose prose-invert prose-quarks mt-8 max-w-none">
      <Content />
    </div>
  </article>
</Base>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  // Solo las actividades con cartel tienen el enlace `#cartel a`.
  new PhotoSwipeLightbox({
    gallery: '#cartel',
    children: 'a',
    pswpModule: () => import('photoswipe'),
    bgOpacity: 0.95,
    closeTitle: 'Cerrar (Esc)',
    zoomTitle: 'Ampliar',
    errorMsg: 'No se pudo cargar la imagen',
  }).init();
</script>
