---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { href } from '../../consts';

const todas = (await getCollection('actividades')).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
);
const actuales = todas.filter((actividad) => !actividad.data.historica);
const historicas = todas.filter((actividad) => actividad.data.historica);

const formatoFecha = (fecha: Date) =>
  fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' });
---

<Base
  titulo="Actividades"
  descripcion="Actividades y noticias de la Asociación Astronómica Quarks: observaciones públicas, charlas, cursos y el archivo histórico de la asociación."
>
  <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <p class="eyebrow">Qué estamos haciendo</p>
    <h1 class="heading mt-3 text-4xl sm:text-5xl">Actividades</h1>
    <p class="mt-4 max-w-2xl leading-relaxed text-fog-300">
      Observaciones públicas, charlas, cursos y quedadas. Y debajo, el archivo: una selección de
      lo que la asociación ha hecho en sus más de treinta años de historia.
    </p>

    <div class="mt-10 space-y-6">
      {
        actuales.map((actividad) => (
          <a href={href(`/actividades/${actividad.id}/`)} class="card card-hover group block overflow-hidden sm:flex">
            {actividad.data.imagen && (
              <div class="shrink-0 sm:w-64">
                <Image
                  src={actividad.data.imagen}
                  alt=""
                  width={512}
                  height={384}
                  fit="cover"
                  class="aspect-[4/3] h-full w-full object-cover"
                />
              </div>
            )}
            <div class="p-6">
              <time class="text-xs tracking-widest text-fog-400 uppercase" datetime={actividad.data.fecha.toISOString()}>
                {formatoFecha(actividad.data.fecha)}
              </time>
              <h2 class="mt-2 font-display text-2xl font-semibold text-fog-50 transition-colors group-hover:text-star-300">
                {actividad.data.titulo}
              </h2>
              <p class="mt-2 leading-relaxed text-fog-300">{actividad.data.resumen}</p>
            </div>
          </a>
        ))
      }
    </div>

    {
      historicas.length > 0 && (
        <section aria-labelledby="titulo-archivo" class="mt-16">
          <h2 id="titulo-archivo" class="heading text-2xl">
            Archivo histórico
          </h2>
          <p class="mt-2 max-w-2xl text-sm text-fog-400">
            Entradas recuperadas de la web antigua de la asociación (2009–2014).
          </p>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            {historicas.map((actividad) => (
              <a href={href(`/actividades/${actividad.id}/`)} class="card card-hover group block p-5">
                <time class="text-xs tracking-widest text-fog-400 uppercase" datetime={actividad.data.fecha.toISOString()}>
                  {formatoFecha(actividad.data.fecha)}
                </time>
                <h3 class="mt-2 font-display text-lg font-semibold text-fog-50 transition-colors group-hover:text-star-300">
                  {actividad.data.titulo}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-fog-300">{actividad.data.resumen}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
