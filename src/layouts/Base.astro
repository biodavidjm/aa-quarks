---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, href } from '../consts';

interface Props {
  /** Título de la pestaña y de Open Graph (sin el nombre del sitio). */
  titulo?: string;
  /** Descripción para buscadores y redes sociales. */
  descripcion?: string;
  /** Ruta (con base incluida) de la imagen social; por defecto la genérica. */
  imagenSocial?: string;
}

const {
  titulo,
  descripcion = SITE.descripcion,
  imagenSocial = href('/og/portada.png'),
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} · ${SITE.nombre}` : SITE.nombre;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagenSocialAbs = new URL(imagenSocial, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#05070d" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenSocialAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenSocialAbs} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <div class="starfield" aria-hidden="true"><i></i></div>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-star-400 focus:px-4 focus:py-2 focus:font-semibold focus:text-night-950"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
