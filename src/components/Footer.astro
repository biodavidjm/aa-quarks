---
import { SITE, REDES, NAV, href } from '../consts';
const año = new Date().getFullYear();
---

<footer class="mt-24 border-t border-night-700/60 bg-night-900/60">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-semibold text-fog-50">{SITE.nombre}</p>
      <p class="mt-2 max-w-xs text-sm leading-relaxed text-fog-400">
        Asociación cultural sin ánimo de lucro fundada en {SITE.fundacion} en Úbeda (Jaén).
        Miembro de la Federación «Camille Flammarion» y de la Red Andaluza de Astronomía
        (RAdA).
      </p>
    </div>

    <nav aria-label="Mapa del sitio" class="text-sm">
      <p class="font-display font-semibold text-fog-100">Secciones</p>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2">
        {
          NAV.map((item) => (
            <li>
              <a class="text-fog-300 transition-colors hover:text-star-300" href={href(item.ruta)}>
                {item.etiqueta}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="text-sm">
      <p class="font-display font-semibold text-fog-100">Contacto</p>
      <ul class="mt-3 space-y-2 text-fog-300">
        <li>
          <a class="transition-colors hover:text-star-300" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        <li>{SITE.localidad}</li>
        {
          REDES.map((red) => (
            <li>
              <a class="transition-colors hover:text-star-300" href={red.url} target="_blank" rel="noopener">
                {red.nombre} — {red.usuario}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-night-700/40">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-fog-500 sm:px-6 md:flex-row md:items-center md:justify-between">
      <p>© {año} {SITE.nombre}. Textos y fotografías de sus autores.</p>
      <p>
        Contenido bajo
        licencia <a
          class="underline decoration-fog-500/50 underline-offset-2 transition-colors hover:text-star-300"
          href="https://creativecommons.org/licenses/by-nc-nd/4.0/deed.es"
          target="_blank"
          rel="license noopener">CC BY-NC-ND 4.0</a
        >, como la web original de la asociación.
      </p>
    </div>
  </div>
</footer>
